<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns:fx="http://javafx.com/fxml/1" fx:controller="seedu.budgie.ui.MainWindow"
            minHeight="540" minWidth="480" prefWidth="520" stylesheets="@MainWindow.css">
    <top>
        <Label text="Budgie — personal budget tracker" styleClass="app-title"
               BorderPane.alignment="CENTER"/>
    </top>
    <center>
        <ScrollPane fx:id="scrollPane" fitToWidth="true" hbarPolicy="NEVER" styleClass="chat-scroll">
            <content>
                <VBox fx:id="dialogContainer" spacing="10.0" styleClass="dialog-list"/>
            </content>
        </ScrollPane>
    </center>
    <bottom>
        <HBox spacing="8.0" alignment="CENTER" styleClass="input-bar">
            <padding>
                <Insets bottom="12.0" left="12.0" right="12.0" top="12.0"/>
            </padding>
            <TextField fx:id="userInput" prefHeight="36.0" promptText="Type a command and press Enter"
                       styleClass="input-field" onAction="#handleUserInput" HBox.hgrow="ALWAYS"/>
            <Button fx:id="sendButton" mnemonicParsing="false" onAction="#handleUserInput" text="Send"
                    styleClass="send-button" prefHeight="36.0" minWidth="72.0"/>
        </HBox>
    </bottom>
</BorderPane>
