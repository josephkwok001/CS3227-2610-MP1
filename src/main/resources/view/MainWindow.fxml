<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>

<AnchorPane xmlns:fx="http://javafx.com/fxml/1" fx:controller="seedu.budgie.ui.MainWindow"
            minHeight="500" minWidth="420" stylesheets="@MainWindow.css">
    <children>
        <ScrollPane fx:id="scrollPane" fitToWidth="true" hbarPolicy="NEVER"
                    AnchorPane.bottomAnchor="52.0" AnchorPane.leftAnchor="0.0"
                    AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
            <content>
                <VBox fx:id="dialogContainer" spacing="8.0" styleClass="dialog-list"/>
            </content>
        </ScrollPane>
        <TextField fx:id="userInput" prefHeight="36.0" promptText="Type a command and press Enter"
                   onAction="#handleUserInput"
                   AnchorPane.bottomAnchor="8.0" AnchorPane.leftAnchor="8.0" AnchorPane.rightAnchor="88.0"/>
        <Button fx:id="sendButton" mnemonicParsing="false" onAction="#handleUserInput" text="Send"
                prefHeight="36.0" prefWidth="72.0"
                AnchorPane.bottomAnchor="8.0" AnchorPane.rightAnchor="8.0"/>
    </children>
</AnchorPane>
